                    {
                      "name": "day",
                      "expression": "`day`"
                    },
                    {
                      "name": "sum(requests)",
                      "expression": "SUM(`requests`)"
                    },
                    {
                      "name": "source",
                      "expression": "`source`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "day",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Day"
                },
                "y": {
                  "fieldName": "sum(requests)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Model requests"
                },
                "color": {
                  "fieldName": "source",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Source"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Model gateway requests: production vs testing",
                "showDescription": true,
                "description": "Production = the deployed app's service principal; testing = evaluations and local runs"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 8,
            "width": 6,
            "height": 5
          }
        },
