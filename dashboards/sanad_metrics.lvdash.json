                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Billed tokens per question",
                "showDescription": true,
                "description": "Mean; ceiling 15,000"
              }
            }
          },
          "position": {
            "x": 9,
            "y": 5,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "quality_trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_trend",
                  "fields": [
                    {
                      "name": "started",
                      "expression": "`started`"
                    },
                    {
                      "name": "avg(value)",
                      "expression": "AVG(`value`)"
                    },
                    {
                      "name": "metric",
                      "expression": "`metric`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "started",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Evaluation run"
                },
                "y": {
                  "fieldName": "avg(value)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Pass rate",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "color": {
                  "fieldName": "metric",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Scorer"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Quality across evaluation runs",
                "showDescription": true,
                "description": "Each point is one full run of the 33-case set; floors are in docs/success-metrics.md"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 8,
            "width": 6,
            "height": 5
          }
        },
        {
