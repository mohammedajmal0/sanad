{
  "datasets": [
    {
      "name": "ds_latest",
      "displayName": "Latest evaluation run",
      "queryLines": [
        "SELECT * FROM eval_scores ORDER BY started DESC LIMIT 1"
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "Quality by evaluation run",
      "queryLines": [
        "SELECT started, run_name, metric, value FROM eval_scores ",
        "UNPIVOT (value FOR metric IN (correctness AS `Correctness`, grounded AS `Grounded`, ",
        "follows_guidelines AS `Follows guidelines`, tool_choice AS `Tool choice`)) ",
        "ORDER BY started"
      ]
    },
    {
      "name": "ds_gateway",
      "displayName": "Model gateway per day",
      "queryLines": [
        "SELECT day, source, requests, tokens, p90_latency_s, error_rate FROM gateway_daily ORDER BY day"
      ]
    },
    {
      "name": "ds_app",
      "displayName": "Production usage and feedback",
      "queryLines": [
        "SELECT sum(questions) AS questions, sum(conversations) AS conversations, ",
        "sum(thumbs_up) + sum(thumbs_down) AS thumbs_given, ",
        "sum(thumbs_up) / nullif(sum(thumbs_up) + sum(thumbs_down), 0) AS thumbs_up_rate ",
        "FROM app_feedback WHERE source = 'production'"
      ]
    }
  ],
  "pages": [
    {
      "name": "metrics",
      "displayName": "Success metrics",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "## Sanad: success metrics\n",
                "\n",
                "The eight JD success measures, from evaluation runs, the model gateway and users' thumbs. ",
                "Data is refreshed on demand by `monitoring/refresh_metrics.py` (about a minute of warehouse time); it holds counts only."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_correct",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_latest",
                  "fields": [
                    {
                      "name": "correctness",
                      "expression": "`correctness`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "correctness",
                  "displayName": "Correctness",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Correctness",
                "showDescription": true,
                "description": "Latest evaluation run; floor 85%"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_grounded",
